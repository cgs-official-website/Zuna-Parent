# ==============================================================================
# ZUNA CENTRAL ADMIN — BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# PostgreSQL Database (Automatically injected by Railway PostgreSQL plugin)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway"

# ------------------------------------------------------------------------------
# Redis Cache & Realtime (Automatically injected by Railway Redis plugin)
# ------------------------------------------------------------------------------
# Format: redis://default:<password>@<host>:<port>
REDIS_URL="redis://default:password@roundhouse.proxy.rlwy.net:6379"

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate strong 32+ character random strings for production
JWT_ACCESS_SECRET="generate_secure_random_string_for_access_tokens_32_chars_min"
JWT_REFRESH_SECRET="generate_secure_random_string_for_refresh_tokens_32_chars_min"

# ------------------------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URLs + localhost for local dev)
FRONTEND_ORIGIN="http://localhost:5173,https://your-frontend-app.vercel.app"

# ------------------------------------------------------------------------------
# Nodemailer SMTP Configuration (Primary for ticket assignment & member notifications)
# ------------------------------------------------------------------------------
# For Gmail: set SMTP_SERVICE="gmail" and use a 16-character Google App Password
SMTP_SERVICE="gmail"
SMTP_USER="support@yourcompany.com"
SMTP_PASS="your-16-char-app-password"

# Or Custom SMTP (Hostinger, cPanel, AWS SES, Mailtrap):
# SMTP_HOST="smtp.yourserver.com"
# SMTP_PORT=587
# SMTP_SECURE=false

# ------------------------------------------------------------------------------
# Transactional Email Fallback (Resend - Optional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Zuna Support <notifications@yourverifieddomain.com>"

